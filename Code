<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
    <title>Unit E - Ward Rounds Pro</title>
    <meta name="theme-color" content="#15803d"/>
    <meta name="apple-mobile-web-app-capable" content="yes"/>
    
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">

    <style>
        /* ═══════════════════════════════════════════════════════════════════════════
           THEME & CORE STYLES
           ═══════════════════════════════════════════════════════════════════════════ */
        :root {
            --primary: #15803d;
            --primary-gradient: linear-gradient(135deg, #15803d 0%, #166534 100%);
            --bg: #f8fafc;
            --bg-card: rgba(255, 255, 255, 0.9);
            --text: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --glass: blur(12px) saturate(180%);
            --radius: 16px;
        }

        [data-theme="dark"] {
            --bg: #0f172a;
            --bg-card: rgba(30, 41, 59, 0.9);
            --text: #f1f5f9;
            --text-muted: #94a3b8;
            --border: #334155;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; outline: none; -webkit-tap-highlight-color: transparent; }
        
        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            transition: background 0.3s, color 0.3s;
            padding-bottom: 120px;
        }

        /* ═══════════════════════════════════════════════════════════════════════════
           COMPONENTS
           ═══════════════════════════════════════════════════════════════════════════ */
        .app-container { max-width: 1200px; margin: 0 auto; padding: 16px; }

        /* Header */
        .header {
            background: var(--primary-gradient);
            color: white;
            padding: 24px;
            border-radius: 24px;
            box-shadow: 0 10px 25px -5px rgba(21, 128, 61, 0.4);
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
        }
        
        .header::before {
            content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 60%);
            animation: rotate 20s linear infinite;
        }

        @keyframes rotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

        .header-content { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; }
        .app-title { font-size: 28px; font-weight: 800; letter-spacing: -1px; }
        .stats-row { display: flex; gap: 20px; margin-top: 20px; border-top: 1px solid rgba(255,255,255,0.2); padding-top: 15px; }
        .stat { display: flex; flex-direction: column; }
        .stat-val { font-size: 24px; font-weight: 700; }
        .stat-lbl { font-size: 11px; opacity: 0.8; text-transform: uppercase; letter-spacing: 1px; }

        /* Controls */
        .controls { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
        .search-wrapper { flex: 1; position: relative; }
        .search-input {
            width: 100%; padding: 12px 12px 12px 40px;
            border-radius: 12px; border: 2px solid var(--border);
            background: var(--bg-card); color: var(--text);
            font-size: 15px; transition: all 0.2s;
        }
        .search-input:focus { border-color: var(--primary); box-shadow: 0 0 0 4px rgba(21, 128, 61, 0.1); }
        .search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); opacity: 0.5; }

        /* Patient Card */
        .card {
            background: var(--bg-card);
            border-radius: var(--radius);
            padding: 18px;
            margin-bottom: 12px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            backdrop-filter: var(--glass);
            -webkit-backdrop-filter: var(--glass);
            transition: transform 0.2s;
            position: relative;
        }
        .card:hover { transform: translateY(-2px); }
        .card.critical { border-left: 5px solid #ef4444; }
        .card.stable { border-left: 5px solid #22c55e; }
        
        .card-header { display: flex; justify-content: space-between; margin-bottom: 12px; }
        .bed-badge { background: var(--text); color: var(--bg); padding: 4px 10px; border-radius: 99px; font-weight: 700; font-size: 12px; }
        .pt-name { font-size: 18px; font-weight: 700; color: var(--text); }
        .pt-meta { font-size: 13px; color: var(--text-muted); display: flex; gap: 12px; margin-bottom: 12px; }
        
        .action-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-top: 12px; }
        .act-btn {
            background: rgba(21, 128, 61, 0.05); color: var(--primary);
            border: none; padding: 8px; border-radius: 8px; font-weight: 600; font-size: 12px;
            cursor: pointer; transition: all 0.2s; display: flex; flex-direction: column; align-items: center; gap: 4px;
        }
        .act-btn:hover { background: var(--primary); color: white; }

        /* Modals */
        .modal-overlay {
            position: fixed; inset: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(5px);
            z-index: 100; display: flex; align-items: center; justify-content: center;
            animation: fadeIn 0.2s ease-out;
        }
        .modal {
            background: var(--bg); width: 95%; max-width: 600px; max-height: 90vh;
            border-radius: 24px; overflow-y: auto; padding: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            animation: slideUp 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        
        /* Floating AI Button */
        .fab-ai {
            position: fixed; bottom: 30px; right: 30px;
            width: 60px; height: 60px; border-radius: 50%;
            background: linear-gradient(135deg, #6366f1, #a855f7);
            color: white; border: none; font-size: 24px;
            box-shadow: 0 10px 25px rgba(99, 102, 241, 0.5);
            cursor: pointer; z-index: 90; display: flex; align-items: center; justify-content: center;
            transition: transform 0.2s;
        }
        .fab-ai:hover { transform: scale(1.1) rotate(10deg); }

        /* Animations */
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
        
        /* Utilities */
        .hidden { display: none; }
        .btn { padding: 10px 20px; border-radius: 10px; border: none; font-weight: 600; cursor: pointer; }
        .btn-primary { background: var(--primary); color: white; }
        .input-group { margin-bottom: 15px; }
        .input-group label { display: block; font-size: 12px; font-weight: 700; color: var(--text-muted); margin-bottom: 5px; text-transform: uppercase; }
        .inp { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border); background: var(--bg); color: var(--text); }
        
        /* Mic Button */
        .mic-wrapper { position: relative; }
        .mic-btn { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; opacity: 0.5; font-size: 16px; }
        .mic-btn.listening { color: #ef4444; opacity: 1; animation: pulse 1s infinite; }
        @keyframes pulse { 0% { transform: translateY(-50%) scale(1); } 50% { transform: translateY(-50%) scale(1.2); } 100% { transform: translateY(-50%) scale(1); } }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        // ═══════════════════════════════════════════════════════════════════════════
        // CONFIG & UTILS
        // ═══════════════════════════════════════════════════════════════════════════
        const CONFIG = {
            wards: ["Ward 19", "Ward 20", "ICU", "ER", "Unassigned"],
            status: ["New", "Stable", "Critical", "Discharge Ready"],
            vitals: {
                bp: { label: 'BP', unit: 'mmHg', critical: [90, 180] },
                hr: { label: 'HR', unit: 'bpm', critical: [50, 120] },
                temp: { label: 'Temp', unit: '°C', critical: [36, 38] },
                spo2: { label: 'SpO2', unit: '%', critical: [90, 100] }
            }
        };

        const Utils = {
            id: () => Math.random().toString(36).substr(2, 9),
            now: () => new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}),
            getStorage: (key, def) => {
                const saved = localStorage.getItem(key);
                return saved ? JSON.parse(saved) : def;
            },
            setStorage: (key, val) => localStorage.setItem(key, JSON.stringify(val))
        };

        // ═══════════════════════════════════════════════════════════════════════════
        // COMPONENTS
        // ═══════════════════════════════════════════════════════════════════════════
        
        // Voice Input Component
        const VoiceInput = ({ value, onChange, placeholder, isArea }) => {
            const [listening, setListening] = React.useState(false);
            
            const toggleListen = () => {
                if (!('webkitSpeechRecognition' in window)) return alert("Voice not supported in this browser");
                if (listening) return; // Stop handled by onend
                
                const recognition = new webkitSpeechRecognition();
                recognition.continuous = false;
                recognition.interimResults = false;
                
                recognition.onstart = () => setListening(true);
                recognition.onend = () => setListening(false);
                recognition.onresult = (e) => {
                    const transcript = e.results[0][0].transcript;
                    onChange(value ? value + " " + transcript : transcript);
                };
                recognition.start();
            };

            return (
                <div className="mic-wrapper">
                    {isArea ? 
                        <textarea className="inp" rows="3" value={value} onChange={e => onChange(e.target.value)} placeholder={placeholder} /> :
                        <input className="inp" value={value} onChange={e => onChange(e.target.value)} placeholder={placeholder} />
                    }
                    <button className={`mic-btn ${listening ? 'listening' : ''}`} onClick={toggleListen}>
                        {listening ? '🔴' : '🎤'}
                    </button>
                </div>
            );
        };

        // Chart Component
        const VitalChart = ({ history, type }) => {
            const canvasRef = React.useRef(null);
            
            React.useEffect(() => {
                if (!history || !canvasRef.current) return;
                const ctx = canvasRef.current.getContext('2d');
                const chart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: history.map(h => new Date(h.ts).toLocaleTimeString()),
                        datasets: [{
                            label: type,
                            data: history.map(h => h.value),
                            borderColor: '#15803d',
                            tension: 0.4,
                            fill: true,
                            backgroundColor: 'rgba(21, 128, 61, 0.1)'
                        }]
                    },
                    options: { responsive: true, plugins: { legend: { display: false } }, scales: { x: { display: false } } }
                });
                return () => chart.destroy();
            }, [history, type]);

            return <canvas ref={canvasRef} height="80"></canvas>;
        };

        // Dr. AI Modal
        const AiModal = ({ patient, onClose }) => {
            const [loading, setLoading] = React.useState(true);
            const [analysis, setAnalysis] = React.useState("");

            React.useEffect(() => {
                // Simulating AI analysis
                setTimeout(() => {
                    const status = patient.status || "Unknown";
                    const diagnosis = patient.diagnosis || "Undiagnosed";
                    setAnalysis(`Based on the clinical data for ${patient.name}, the patient is currently ${status}.\n\nPrimary Concern: ${diagnosis}.\n\nRecommendation:\n1. Continue monitoring Vitals every 4 hours.\n2. Review current medication list for interactions.\n3. Schedule follow-up labs in the morning.`);
                    setLoading(false);
                }, 1500);
            }, []);

            return (
                <div className="modal-overlay" onClick={onClose}>
                    <div className="modal" onClick={e => e.stopPropagation()}>
                        <div style={{textAlign: 'center', marginBottom: 20}}>
                            <div style={{fontSize: 40, marginBottom: 10}}>🤖</div>
                            <h3>Dr. AI Analysis</h3>
                            <p style={{color: 'var(--text-muted)'}}>Generating clinical insights...</p>
                        </div>
                        {loading ? (
                            <div style={{display: 'flex', justifyContent: 'center', padding: 20}}>
                                <div className="header-badge syncing" style={{color: 'var(--primary)'}}>Analyzing...</div>
                            </div>
                        ) : (
                            <div style={{background: 'var(--bg-card)', padding: 15, borderRadius: 12, lineHeight: 1.6, whiteSpace: 'pre-line'}}>
                                {analysis}
                            </div>
                        )}
                        <button className="btn btn-primary" style={{width: '100%', marginTop: 20}} onClick={onClose}>Close</button>
                    </div>
                </div>
            );
        };

        // Main App
        const App = () => {
            // State
            const [patients, setPatients] = React.useState(Utils.getStorage('patients', [
                { id: '1', name: 'John Doe', bed: '05', ward: 'Ward 19', diagnosis: 'Pneumonia', status: 'Stable', vitals: { bp: 120, hr: 80 }, history: [] }
            ]));
            const [theme, setTheme] = React.useState('light');
            const [search, setSearch] = React.useState('');
            const [activeModal, setActiveModal] = React.useState(null); // { type: 'add'|'vitals'|'ai', data: ... }

            // Effects
            React.useEffect(() => Utils.setStorage('patients', patients), [patients]);
            React.useEffect(() => document.documentElement.setAttribute('data-theme', theme), [theme]);

            // Actions
            const addPatient = (p) => {
                setPatients([...patients, { ...p, id: Utils.id(), history: [] }]);
                setActiveModal(null);
            };

            const updatePatient = (id, updates) => {
                setPatients(patients.map(p => p.id === id ? { ...p, ...updates } : p));
            };

            const addVital = (pid, type, val) => {
                setPatients(patients.map(p => {
                    if (p.id !== pid) return p;
                    const hist = p.history || [];
                    return { 
                        ...p, 
                        vitals: { ...p.vitals, [type]: val },
                        history: [...hist, { ts: Date.now(), type, value: val }]
                    };
                }));
            };

            // Filter
            const filtered = patients.filter(p => 
                p.name.toLowerCase().includes(search.toLowerCase()) || 
                p.diagnosis.toLowerCase().includes(search.toLowerCase())
            );

            // Group by Ward
            const wards = [...new Set(filtered.map(p => p.ward))];

            return (
                <div className="app-container">
                    {/* Header */}
                    <div className="header">
                        <div className="header-content">
                            <div>
                                <h1 className="app-title">🏥 Unit E Rounds</h1>
                                <div style={{opacity: 0.8}}>{new Date().toDateString()}</div>
                            </div>
                            <button className="btn" style={{background: 'rgba(255,255,255,0.2)'}} onClick={() => setTheme(theme === 'light' ? 'dark' : 'light')}>
                                {theme === 'light' ? '🌙' : '☀️'}
                            </button>
                        </div>
                        <div className="stats-row">
                            <div className="stat"><span className="stat-val">{patients.length}</span><span className="stat-lbl">Total</span></div>
                            <div className="stat"><span className="stat-val">{patients.filter(p => p.status === 'Critical').length}</span><span className="stat-lbl">Critical</span></div>
                            <div className="stat"><span className="stat-val">{patients.filter(p => p.status === 'New').length}</span><span className="stat-lbl">Admissions</span></div>
                        </div>
                    </div>

                    {/* Controls */}
                    <div className="controls">
                        <div className="search-wrapper">
                            <span className="search-icon">🔍</span>
                            <input className="search-input" placeholder="Search patients, diagnoses..." value={search} onChange={e => setSearch(e.target.value)} />
                        </div>
                        <button className="btn btn-primary" onClick={() => setActiveModal({ type: 'add' })}>+ Add Patient</button>
                    </div>

                    {/* Ward Lists */}
                    {wards.map(ward => (
                        <div key={ward} style={{marginBottom: 24}}>
                            <h3 style={{marginBottom: 12, paddingLeft: 8, borderLeft: '4px solid var(--primary)', color: 'var(--text-muted)'}}>{ward}</h3>
                            {filtered.filter(p => p.ward === ward).map(p => (
                                <div key={p.id} className={`card ${p.status === 'Critical' ? 'critical' : 'stable'}`}>
                                    <div className="card-header">
                                        <div style={{display:'flex', alignItems:'center', gap: 10}}>
                                            <span className="bed-badge">{p.bed || 'NO BED'}</span>
                                            <div>
                                                <div className="pt-name">{p.name}</div>
                                                <div style={{fontSize: 12, opacity: 0.7}}>{p.diagnosis}</div>
                                            </div>
                                        </div>
                                        <div style={{textAlign:'right'}}>
                                            <div style={{fontWeight: 700, color: p.status === 'Critical' ? '#ef4444' : 'var(--primary)'}}>{p.status}</div>
                                            <div style={{fontSize: 11, opacity: 0.5}}>MRN: {p.mrn || '---'}</div>
                                        </div>
                                    </div>
                                    
                                    {/* Mini Vitals Display */}
                                    <div style={{display:'flex', gap: 15, fontSize: 13, background: 'rgba(0,0,0,0.03)', padding: 8, borderRadius: 8}}>
                                        <span>❤️ <b>{p.vitals?.hr || '--'}</b></span>
                                        <span>🩸 <b>{p.vitals?.bp || '--'}</b></span>
                                        <span>🌡️ <b>{p.vitals?.temp || '--'}</b></span>
                                    </div>

                                    <div className="action-grid">
                                        <button className="act-btn" onClick={() => setActiveModal({ type: 'vitals', data: p })}><span>📊</span>Vitals</button>
                                        <button className="act-btn" onClick={() => setActiveModal({ type: 'tasks', data: p })}><span>✅</span>Tasks</button>
                                        <button className="act-btn" onClick={() => setActiveModal({ type: 'ai', data: p })}><span>🤖</span>Dr. AI</button>
                                        <button className="act-btn" style={{color: '#ef4444'}} onClick={() => { if(confirm('Discharge?')) setPatients(patients.filter(x => x.id !== p.id)) }}><span>🚪</span>Exit</button>
                                    </div>
                                </div>
                            ))}
                        </div>
                    ))}

                    {/* Floating AI Button */}
                    <button className="fab-ai" onClick={() => alert('Global AI Assistant: Try clicking "Dr. AI" on a patient card!')}>🧠</button>

                    {/* MODALS */}
                    
                    {/* Add Patient Modal */}
                    {activeModal?.type === 'add' && (
                        <div className="modal-overlay" onClick={() => setActiveModal(null)}>
                            <div className="modal" onClick={e => e.stopPropagation()}>
                                <h2>Add Patient</h2>
                                <div className="input-group">
                                    <label>Full Name</label>
                                    <VoiceInput placeholder="e.g. Jane Doe" onChange={val => activeModal.temp = {...activeModal.temp, name: val}} />
                                    <input className="inp" placeholder="Name" onChange={e => activeModal.temp = {...activeModal.temp, name: e.target.value}} />
                                </div>
                                <div style={{display:'flex', gap: 10}}>
                                    <div className="input-group" style={{flex:1}}>
                                        <label>Ward</label>
                                        <select className="inp" onChange={e => activeModal.temp = {...activeModal.temp, ward: e.target.value}}>
                                            {CONFIG.wards.map(w => <option key={w}>{w}</option>)}
                                        </select>
                                    </div>
                                    <div className="input-group" style={{flex:1}}>
                                        <label>Bed</label>
                                        <input className="inp" placeholder="Bed #" onChange={e => activeModal.temp = {...activeModal.temp, bed: e.target.value}} />
                                    </div>
                                </div>
                                <div className="input-group">
                                    <label>Diagnosis</label>
                                    <VoiceInput placeholder="Primary diagnosis..." onChange={val => activeModal.temp = {...activeModal.temp, diagnosis: val}} />
                                    <input className="inp" onChange={e => activeModal.temp = {...activeModal.temp, diagnosis: e.target.value}} />
                                </div>
                                <button className="btn btn-primary" style={{width:'100%'}} onClick={() => {
                                    if (activeModal.temp?.name) addPatient({ ward: CONFIG.wards[0], status: 'New', ...activeModal.temp });
                                }}>Save Admission</button>
                            </div>
                        </div>
                    )}

                    {/* Vitals Modal */}
                    {activeModal?.type === 'vitals' && (
                        <div className="modal-overlay" onClick={() => setActiveModal(null)}>
                            <div className="modal" onClick={e => e.stopPropagation()}>
                                <h2>Vitals: {activeModal.data.name}</h2>
                                <div style={{marginBottom: 20}}>
                                    <div className="input-group">
                                        <label>Heart Rate (BPM)</label>
                                        <input type="number" className="inp" defaultValue={activeModal.data.vitals?.hr} 
                                            onBlur={e => addVital(activeModal.data.id, 'hr', e.target.value)} />
                                    </div>
                                    <VitalChart type="Heart Rate" history={activeModal.data.history?.filter(h => h.type === 'hr')} />
                                </div>
                                <div style={{marginBottom: 20}}>
                                    <div className="input-group">
                                        <label>Blood Pressure</label>
                                        <input className="inp" defaultValue={activeModal.data.vitals?.bp} 
                                            onBlur={e => addVital(activeModal.data.id, 'bp', e.target.value)} />
                                    </div>
                                </div>
                                <button className="btn btn-primary" style={{width:'100%'}} onClick={() => setActiveModal(null)}>Done</button>
                            </div>
                        </div>
                    )}

                    {/* AI Modal */}
                    {activeModal?.type === 'ai' && <AiModal patient={activeModal.data} onClose={() => setActiveModal(null)} />}

                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>

